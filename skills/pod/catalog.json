          "checked": "2026-09-25"
        }
      ],
      "guide": {
        "profile": "high",
        "suggested_use": "Planning and review",
        "best_for": "Planning, architecture and substantial code review.",
        "use_when": "Work spans modules or needs careful, sustained judgment.",
        "ladder": {
          "quick": "low",
          "normal": "medium",
          "hard": "high",
          "escalation": "xhigh"
        },
        "trade_off": "Top AA index here from medium up; slower, costlier than Sol.",
        "examples": [
          {
            "effort": "high",
            "text": "Review a cross-cutting design before merge."
